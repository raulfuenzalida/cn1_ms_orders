# Configuración del servidor
SERVER_PORT=8082

# Configuración de base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=orders_user
DB_PASSWORD=orders_password

# Configuración de ms_products
MS_PRODUCTS_BASE_URL=http://localhost:8081

# Configuración de RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Configuración Kafka (consumo de filamento al confirmar pedidos)
# Clúster 3 Zookeeper + 3 brokers; ver cn1_kafka_cluster/README.md
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_FILAMENT_CONSUMPTION=printworks.filament-consumption

# Configuración CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://raulfuenzalida.github.io

# Configuración OAuth2 / Azure AD (front_admin - ROLE_ADMIN)
OAUTH2_ISSUER_URI=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
OAUTH2_AUDIENCE=api://YOUR_CLIENT_ID
OAUTH2_AUDIENCE_ID=YOUR_CLIENT_ID

# Configuración AWS Cognito (front_public clientes - ROLE_CLIENT)
# User Pool ID del Cognito configurado para cn1_front_public.
# AWS_REGION ya está definida arriba (se usa también para Kinesis).
COGNITO_USER_POOL_ID=YOUR_USER_POOL_ID
